# Copy to .env.local for local development.

# --- Scan ingestion -------------------------------------------------------

# Bearer token required by POST /api/security/scans.
# When unset, ingestion is refused with 503 in production and allowed without a
# token only in development. Generate one with: openssl rand -hex 32
SECURITY_INGEST_TOKEN=

# --- Data -----------------------------------------------------------------

# "mock" (default) seeds clearly-labelled demo findings so the dashboard has
# data on first run. "live" starts with an empty store and waits for real
# ingestion. With a database, seeding only happens when the store is empty.
SECURITY_DATA_SOURCE=mock

# --- Storage --------------------------------------------------------------

# PostgreSQL connection string. Setting it switches storage from the in-memory
# store to Postgres; leaving it unset keeps the zero-setup default.
# Run `npm run db:migrate` once after setting it.
#
#   docker run -d --name dashboard-pg \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=dashboard \
#     -p 5432:5432 postgres:17-alpine
#
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/dashboard

# Force a storage driver, overriding the DATABASE_URL-based default.
# SECURITY_STORAGE=postgres

# Maximum pooled connections (default 10).
# DATABASE_POOL_MAX=10

# Transient-failure retry. Only connection-class, deadlock/serialization and
# resource-exhaustion errors are retried; constraint and syntax errors fail
# immediately. Backoff is exponential with full jitter.
# DATABASE_MAX_RETRIES=3
# DATABASE_RETRY_BASE_DELAY_MS=100
# DATABASE_RETRY_MAX_DELAY_MS=2000

# --- Testing --------------------------------------------------------------

# Test-only. When set, the PostgreSQL test suites run against this database
# instead of skipping. Its schemas are DROPPED and TRUNCATED between tests, so
# never point this at anything you care about.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/dashboard_test
